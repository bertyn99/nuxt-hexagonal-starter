{
  "name": "nuxt-hexagonal-logistics",
  "version": "1.0.0",
  "private": true,
  "description": "Nuxt 4 Hexagonal Modular Monolith template (Logistics: Storage & Delivery) with Nuxt UI v4",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.domain.json --noEmit",
    "typecheck:domain": "tsc -p tsconfig.domain.json --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:arch": "vitest run --project arch",
    "test:nuxt": "vitest run --project nuxt",
    "test:e2e": "vitest run --project e2e"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@nuxt/ui": "^4.0.0",
    "@tanstack/charts": "latest",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.45.0",
    "evlog": "^2.37.1",
    "nuxt": "^4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.0.0",
    "@nuxt/test-utils": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "typescript": "^5.8.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "better-sqlite3",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
